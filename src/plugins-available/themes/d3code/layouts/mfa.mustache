<div class="container">
    <div class="row justify-content-center">
        <div class="col-12 col-md-9 col-lg-7 col-xl-6">
            <h1 class="text-center mb-5">Confirm Login</h1>
            <div class="card">
                <div class="card-body p-5">
                    <form class="form-signin  m-auto" autocomplete="off" action="/interaction/{{uid}}/mfa" method="post">
                        <!-- CSRF Protection -->
                        <input type="hidden" name="_csrf" value="{{csrfToken}}">

                        <div class="form-floating">
                            <input  id="login_mfa"
                                    class="form-control"
                                    type="number"
                                    name="mfa"
                                    placeholder="------">
                            <label for="login_mfa">One Time Passcode</label>
                        </div>

                        <button class="btn btn-primary w-100 py-2 my-2" type="submit">Sign in</button>

                        <div class="col-2 w-100">
                            <a class="btn btn-outline-secondary w-100 py-2 my-2" href="/interaction/{{ uid }}/abort">Cancel</a>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
